<?xml version="1.0" encoding="utf-8" ?>
<language>
	<str id="optionsMenu.desc-missing">无描述</str>

	<group name="OptionsMenu">
		<str id="optionsMenu.advanced">Advanced</str>
		<str id="optionsMenu.header.title">设置菜单</str>
		<str id="optionsMenu.header.desc">选择一个设置项以继续</str>

		<str id="optionsTree.controls-name">Controls</str>
		<str id="optionsTree.controls-desc">更改控制选项</str>

		<str id="optionsTree.gameplay-name">Gameplay</str>
		<str id="optionsTree.gameplay-desc">更改游戏玩法选项(原版),例如按键布局、机制特性、NoHitMode等……</str>
		<str id="optionsTree.gameplay.advanced-desc">更改一些Dustin里不该存在的设置项,例如音频流式传输等……</str>

		<str id="optionsTree.appearance-name">Appearance</str>
		<str id="optionsTree.appearance-desc">更改外观选项,例如光影、帧率等……</str>
		<str id="optionsTree.appearance.advanced-desc">更改光影与更多设置项,例如仅显存精灵、抗锯齿等……</str>

		<str id="optionsTree.language-name">Language</str>
		<str id="optionsTree.language-desc">这个选项不该这里的,不是吗?</str>

		<str id="optionsTree.miscellaneous-name">Miscellaneous</str>
		<str id="optionsTree.miscellaneous-desc">更改游戏重要设置,例如重置存档数据或引擎设置</str>

		<str id="optionsTree.debug-name">Debug Options</str>
		<str id="optionsTree.debug-desc">开发者模式的调试选项</str>

		<str id="optionsTree.mobile-name">Mobile Options</str>
		<str id="optionsTree.mobile-desc">更改与手机触摸相关的选项</str>
	</group>

	<group name="KeybindOptions" prefix="KeybindsOptions.">
		<str id="left">Left</str>
		<str id="down">Down</str>
