		<str id="category.ui">UI</str>
		<group name="ui" prefix="ui.">
			<str id="accept">Accept</str>
			<str id="back">Back</str>
			<str id="reset">Reset</str>
			<str id="pause">Pause</str>
			<str id="changeMode">Change Mode</str>
